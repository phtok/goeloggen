{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(sed -n *)",
      "Bash(jq *)",
      "Bash(git config core.hooksPath tools/hooks)",
      "Bash(python3 tools/typo-check.py *)",
      "Bash(python3 tools/ds-lint.py *)",
      "Bash(python3 tools/ds-fix.py *)",
      "Bash(node tools/barrierefreiheit.mjs *)",
      "Bash(python3 tools/build_sections.py *)",
      "Bash(python3 tools/build_tool_aliases.py *)",
      "mcp__github__get_me",
