      "mas": { "dunkel": { "$value": "#415a8a" }, "hell": { "$value": "#eef4ff" }, "hell_dunkelmodus": { "$value": "#1e2637" }, "ink": { "$value": "#415a8a" }, "ink_dunkelmodus": { "$value": "#a8c5fa" }, "$description": "Mathematisch-Astronomische Sektion" },
